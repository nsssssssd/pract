// ============================================================================
// ВНЕШНЯЯ ОБРАБОТКА: "Выгрузка заказов в JSON"
// Платформа: 1С:Предприятие 8.3 (управляемые формы)
// Назначение: выгружает заказы покупателей в JSON-файл для сайта на Next.js
// ============================================================================
// Как использовать:
// 1. В конфигураторе создайте новую внешнюю обработку.
// 2. Добавьте управляемую форму (пустую, без реквизитов и элементов).
// 3. Вставьте ЭТОТ КОД полностью в модуль формы.
// 4. Сохраните обработку как .epf.
// 5. Откройте в режиме 1С:Предприятие — форма создастся автоматически.
// ============================================================================

&НаСервере
Функция РеквизитФормыСуществует(ИмяРеквизита)
    Для Каждого Реквизит Из ПолучитьРеквизиты() Цикл
        Если Реквизит.Имя = ИмяРеквизита Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаСервере
Функция КомандаСуществует(ИмяКоманды)
    Для Каждого Команда Из Команды Цикл
        Если Команда.Имя = ИмяКоманды Тогда
            Возврат Истина;
        КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Попытка
        
        // ---------- Добавляем реквизиты формы (если их ещё нет) ----------
        ДобавляемыеРеквизиты = Новый Массив;
        
        Если НЕ РеквизитФормыСуществует("ПутьКФайлу") Тогда
            ДобавляемыеРеквизиты.Добавить(
                Новый РеквизитФормы("ПутьКФайлу", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)))
            );
        КонецЕсли;
        
        Если НЕ РеквизитФормыСуществует("ДатаНачала") Тогда
            ДобавляемыеРеквизиты.Добавить(
                Новый РеквизитФормы("ДатаНачала", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)))
            );
        КонецЕсли;
        
        Если НЕ РеквизитФормыСуществует("ДатаОкончания") Тогда
            ДобавляемыеРеквизиты.Добавить(
                Новый РеквизитФормы("ДатаОкончания", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)))
            );
        КонецЕсли;
        
        Если НЕ РеквизитФормыСуществует("СтатусЗаказа") Тогда
            ДобавляемыеРеквизиты.Добавить(
                Новый РеквизитФормы("СтатусЗаказа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)))
            );
        КонецЕсли;
        
        Если ДобавляемыеРеквизиты.Количество() > 0 Тогда
            ИзменитьРеквизиты(ДобавляемыеРеквизиты);
        КонецЕсли;
        
        // ---------- Добавляем команду (если её ещё нет) ----------
        Если НЕ КомандаСуществует("ВыгрузитьЗаказы") Тогда
            Команда = Команды.Добавить("ВыгрузитьЗаказы");
            Команда.Действие = "ВыгрузитьЗаказы";
            Команда.Заголовок = "Выгрузить заказы";
            Команда.Подсказка = "Сформировать JSON-файл с заказами";
        КонецЕсли;
        
        // ---------- Создаём основную группу ----------
        ГруппаРодитель = Неопределено;
        Если Элементы.Найти("ГруппаОсновная") = Неопределено Тогда
            ГруппаРодитель = Элементы.Добавить("ГруппаОсновная", Тип("ГруппаФормы"));
            ГруппаРодитель.Вид = ВидГруппыФормы.ОбычнаяГруппа;
            ГруппаРодитель.Заголовок = "Параметры выгрузки";
            ГруппаРодитель.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
            ГруппаРодитель.РастягиватьПоГоризонтали = Истина;
        Иначе
            ГруппаРодитель = Элементы.ГруппаОсновная;
        КонецЕсли;
        
        // ---------- Добавляем элементы на форму (если их ещё нет) ----------
        
        // Поле "Путь к файлу"
        Если Элементы.Найти("ПутьКФайлу") = Неопределено Тогда
            Элемент = Элементы.Добавить("ПутьКФайлу", Тип("ПолеФормы"), ГруппаРодитель);
            Элемент.Вид = ВидПоляФормы.ПолеВвода;
            Элемент.ПутьКДанным = "ПутьКФайлу";
            Элемент.Заголовок = "Путь к файлу";
            Элемент.ПодсказкаВвода = "C:\\1C\\Exchange\\orders.json";
            Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
            Элемент.РастягиватьПоГоризонтали = Истина;
        КонецЕсли;
        
        // Поле "Дата начала"
        Если Элементы.Найти("ДатаНачала") = Неопределено Тогда
            Элемент = Элементы.Добавить("ДатаНачала", Тип("ПолеФормы"), ГруппаРодитель);
            Элемент.Вид = ВидПоляФормы.ПолеВвода;
            Элемент.ПутьКДанным = "ДатаНачала";
            Элемент.Заголовок = "Дата начала";
            Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
            Элемент.Ширина = 15;
        КонецЕсли;
        
        // Поле "Дата окончания"
        Если Элементы.Найти("ДатаОкончания") = Неопределено Тогда
            Элемент = Элементы.Добавить("ДатаОкончания", Тип("ПолеФормы"), ГруппаРодитель);
            Элемент.Вид = ВидПоляФормы.ПолеВвода;
            Элемент.ПутьКДанным = "ДатаОкончания";
            Элемент.Заголовок = "Дата окончания";
            Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
            Элемент.Ширина = 15;
        КонецЕсли;
        
        // Поле "Статус заказа"
        Если Элементы.Найти("СтатусЗаказа") = Неопределено Тогда
            Элемент = Элементы.Добавить("СтатусЗаказа", Тип("ПолеФормы"), ГруппаРодитель);
            Элемент.Вид = ВидПоляФормы.ПолеВвода;
            Элемент.ПутьКДанным = "СтатусЗаказа";
            Элемент.Заголовок = "Статус заказа (необязательно)";
            Элемент.ПодсказкаВвода = "Оставьте пустым для выгрузки всех";
            Элемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
            Элемент.РастягиватьПоГоризонтали = Истина;
        КонецЕсли;
        
        // Кнопка "Выгрузить заказы"
        Если Элементы.Найти("КнопкаВыгрузитьЗаказы") = Неопределено Тогда
            Кнопка = Элементы.Добавить("КнопкаВыгрузитьЗаказы", Тип("КнопкаФормы"), ГруппаРодитель);
            Кнопка.ИмяКоманды = "ВыгрузитьЗаказы";
            Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
            Кнопка.Ширина = 25;
            Кнопка.Высота = 2;
        КонецЕсли;
        
        // ---------- Значения по умолчанию ----------
        Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
            ПутьКФайлу = "C:\\1C\\Exchange\\orders.json";
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
            ДатаНачала = НачалоМесяца(ТекущаяДата());
        КонецЕсли;
        
        Если НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
            ДатаОкончания = КонецДня(ТекущаяДата());
        КонецЕсли;
        
    Исключение
        Инфо = ИнформацияОбОшибке();
        Сообщить("ОШИБКА при создании формы: " + Инфо.Описание);
        Сообщить("Подробности: " + Инфо.ПодробноеОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗаказы(Команда)
    ВыгрузитьЗаказыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьЗаказыНаСервере()
    
    // ---------- НАСТРОЙКИ ПОД ВАШУ БАЗУ ----------
    ИмяДокументаЗаказ = "ЗаказПокупателя";  // замените на имя вашего документа
    ИмяРеквизитаКонтрагент = "Контрагент";    // контрагент в шапке заказа
    ИмяРеквизитаАдрес = "АдресДоставки";      // адрес доставки (строка или не заполнен)
    ИмяТабЧастиТовары = "Товары";             // табличная часть с товарами
    ИмяРеквизитаСтатус = "Статус";            // статус заказа (строка/перечисление)
    ИмяРеквизитаТелефон = "Телефон";          // телефон контрагента
    
    // Если в вашей базе телефон хранится в контакте/табличной части — подстройте запрос
    // ---------------------------------------------
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Заказ.Ссылка КАК Ссылка,
        |   Заказ.Номер КАК Номер,
        |   Заказ.Дата КАК Дата,
        |   Заказ." + ИмяРеквизитаСтатус + " КАК Статус,
        |   Заказ." + ИмяРеквизитаКонтрагент + ".Представление КАК Клиент,
        |   ЕСТЬNULL(Заказ." + ИмяРеквизитаКонтрагент + "." + ИмяРеквизитаТелефон + ", """") КАК Телефон,
        |   Заказ." + ИмяРеквизитаАдрес + " КАК Адрес
        |ИЗ
        |   Документ." + ИмяДокументаЗаказ + " КАК Заказ
        |ГДЕ
        |   Заказ.Проведен
        |   И Заказ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
    
    // Если фильтр по статусу задан
    Если ЗначениеЗаполнено(СтатусЗаказа) Тогда
        Запрос.Текст = Запрос.Текст + "
        |   И Заказ." + ИмяРеквизитаСтатус + " = &СтатусЗаказа";
        Запрос.УстановитьПараметр("СтатусЗаказа", СтатусЗаказа);
    КонецЕсли;
    
    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
    
    Результат = Запрос.Выполнить().Выбрать();
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписьJSON.ЗаписатьНачалоОбъекта();
    ЗаписьJSON.ЗаписатьИмяСвойства("orders");
    ЗаписьJSON.ЗаписатьНачалоМассива();
    
    Пока Результат.Следующий() Цикл
        
        ЗаказОбъект = Результат.Ссылка.ПолучитьОбъект();
        
        // Считаем сумму заказа по табличной части
        СуммаДокумента = 0;
        Для Каждого СтрокаТовары Из ЗаказОбъект[ИмяТабЧастиТовары] Цикл
            СуммаДокумента = СуммаДокумента + СтрокаТовары.Сумма;
        КонецЦикла;
        
        ЗаписьJSON.ЗаписатьНачалоОбъекта();
        
        ЗаписьJSON.ЗаписатьИмяСвойства("number");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Результат.Номер));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("date");
        ЗаписьJSON.ЗаписатьЗначение(Формат(Результат.Дата, "ДФ=yyyy-MM-dd"));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("status");
        ЗаписьJSON.ЗаписатьЗначение(Строка(Результат.Статус));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("total");
        ЗаписьJSON.ЗаписатьЗначение(Число(СуммаДокумента));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("clientName");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Результат.Клиент));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("clientPhone");
        ЗаписьJSON.ЗаписатьЗначение(НормализоватьТелефон(Результат.Телефон));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("address");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(?(ЗначениеЗаполнено(Результат.Адрес), Результат.Адрес, "—")));
        
        // --- Товары ---
        ЗаписьJSON.ЗаписатьИмяСвойства("items");
        ЗаписьJSON.ЗаписатьНачалоМассива();
        
        Для Каждого СтрокаТовары Из ЗаказОбъект[ИмяТабЧастиТовары] Цикл
            
            ЗаписьJSON.ЗаписатьНачалоОбъекта();
            
            ЗаписьJSON.ЗаписатьИмяСвойства("name");
            ЗаписьJSON.ЗаписатьЗначение(СокрЛП(СтрокаТовары.Номенклатура));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("quantity");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Количество));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("price");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Цена));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("sum");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Сумма));
            
            ЗаписьJSON.ЗаписатьКонецОбъекта();
            
        КонецЦикла;
        
        ЗаписьJSON.ЗаписатьКонецМассива();
        
        ЗаписьJSON.ЗаписатьКонецОбъекта();
        
    КонецЦикла;
    
    ЗаписьJSON.ЗаписатьКонецМассива();
    ЗаписьJSON.ЗаписатьКонецОбъекта();
    
    JSONТекст = ЗаписьJSON.Закрыть();
    
    // Записываем файл
    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.УстановитьТекст(JSONТекст);
    ТекстовыйДокумент.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
    
    Сообщить("Выгружено заказов: " + Результат.Количество());
    Сообщить("Файл сохранён: " + ПутьКФайлу);
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция НормализоватьТелефон(Телефон)
    
    Результат = "";
    Для Индекс = 1 По СтрДлина(Телефон) Цикл
        Символ = Сред(Телефон, Индекс, 1);
        Если Найти("0123456789", Символ) > 0 Тогда
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;
    
    // Приводим к формату 7XXXXXXXXXX
    Если СтрДлина(Результат) = 11 И Лев(Результат, 1) = "8" Тогда
        Результат = "7" + Сред(Результат, 2);
    ИначеЕсли СтрДлина(Результат) = 10 Тогда
        Результат = "7" + Результат;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции
