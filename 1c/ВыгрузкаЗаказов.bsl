// 1С:Предприятие 8.3 — модуль выгрузки заказов в XML (CommerceML)
//
// Как использовать:
// 1. Создайте в конфигураторе новую обработку (Файл → Новый → Обработка)
// 2. Добавьте на форму кнопку и привяжите к ней эту процедуру
// 3. Укажите путь к файлу (например, "C:\\1C\\Exchange\\orders.xml")
// 4. Нажмите кнопку — заказы выгрузятся в XML

// ==================== ПРОЦЕДУРА ВЫГРУЗКИ ====================

Процедура ВыгрузитьЗаказыВXML(ПутьКФайлу) Экспорт

    ЗаписьXML = Новый ЗаписьXML;
    ЗаписьXML.ОткрытьФайл(ПутьКФайлу, "UTF-8");
    ЗаписьXML.ЗаписатьОбъявлениеXML();

    // Корневой элемент CommerceML
    ЗаписьXML.ЗаписатьНачалоЭлемента("КоммерческаяИнформация");
    ЗаписьXML.ЗаписатьАтрибут("ВерсияСхемы", "2.10");
    ЗаписьXML.ЗаписатьАтрибут("ДатаФормирования", Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd"));

    // Запрос всех заказов покупателей (или отфильтруйте по дате/статусу)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |   ЗаказПокупателя.Ссылка КАК Заказ,
    |   ЗаказПокупателя.Номер КАК Номер,
    |   ЗаказПокупателя.Дата КАК Дата,
    |   ЗаказПокупателя.СуммаДокумента КАК Сумма,
    |   ЗаказПокупателя.Контрагент.Наименование КАК Клиент,
    |   ЗаказПокупателя.Контрагент.Телефон КАК Телефон,
    |   ЗаказПокупателя.СостояниеЗаказа.Наименование КАК Статус
    |ИЗ
    |   Документ.ЗаказПокупателя КАК ЗаказПокупателя
    |ГДЕ
    |   ЗаказПокупателя.Проведен = ИСТИНА
    |   И ЗаказПокупателя.Дата >= &ДатаНачала
    |УПОРЯДОЧИТЬ ПО
    |   ЗаказПокупателя.Дата УБЫВ";

    // Выгружаем заказы за последние 30 дней (можно изменить)
    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДата() - 30 * 86400));

    Результат = Запрос.Выполнить().Выбрать();

    Пока Результат.Следующий() Цикл

        ЗаписьXML.ЗаписатьНачалоЭлемента("Документ");

        // Реквизиты заказа
        ЗаписатьXMLЭлемент(ЗаписьXML, "Ид",          Строка(Результат.Заказ.УникальныйИдентификатор()));
        ЗаписатьXMLЭлемент(ЗаписьXML, "Номер",       Результат.Номер);
        ЗаписатьXMLЭлемент(ЗаписьXML, "Дата",        Формат(Результат.Дата, "ДФ=yyyy-MM-dd"));
        ЗаписатьXMLЭлемент(ЗаписьXML, "ХозОперация", "Заказ товара");
        ЗаписатьXMLЭлемент(ЗаписьXML, "Роль",        "Продавец");
        ЗаписатьXMLЭлемент(ЗаписьXML, "Сумма",       Формат(Результат.Сумма, "ЧРД=.; ЧГ=0"));
        ЗаписатьXMLЭлемент(ЗаписьXML, "Валюта",      "руб");
        ЗаписатьXMLЭлемент(ЗаписьXML, "Статус",      ?(ЗначениеЗаполнено(Результат.Статус), Результат.Статус, "Новый"));

        // Контрагент (клиент)
        ЗаписьXML.ЗаписатьНачалоЭлемента("Контрагенты");
        ЗаписьXML.ЗаписатьНачалоЭлемента("Контрагент");
        ЗаписатьXMLЭлемент(ЗаписьXML, "Ид",          Строка(Результат.Заказ.Контрагент.УникальныйИдентификатор()));
        ЗаписатьXMLЭлемент(ЗаписьXML, "Наименование", Результат.Клиент);
        ЗаписатьXMLЭлемент(ЗаписьXML, "Телефон",     НормализоватьТелефон(Результат.Телефон));
        ЗаписьXML.ЗаписатьКонецЭлемента(); // Контрагент
        ЗаписьXML.ЗаписатьКонецЭлемента(); // Контрагенты

        // Товары по заказу
        ЗаписьXML.ЗаписатьНачалоЭлемента("Товары");

        ЗапросТовары = Новый Запрос;
        ЗапросТовары.Текст =
        "ВЫБРАТЬ
        |   ЗаказПокупателяТовары.Номенклатура.Наименование КАК Наименование,
        |   ЗаказПокупателяТовары.Количество КАК Количество,
        |   ЗаказПокупателяТовары.Цена КАК Цена,
        |   ЗаказПокупателяТовары.Сумма КАК Сумма
        |ИЗ
        |   Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
        |ГДЕ
        |   ЗаказПокупателяТовары.Ссылка = &Заказ";
        ЗапросТовары.УстановитьПараметр("Заказ", Результат.Заказ);

        Товары = ЗапросТовары.Выполнить().Выбрать();
        Пока Товары.Следующий() Цикл
            ЗаписьXML.ЗаписатьНачалоЭлемента("Товар");
            ЗаписатьXMLЭлемент(ЗаписьXML, "Ид",          Строка(Товары.Наименование));
            ЗаписатьXMLЭлемент(ЗаписьXML, "Наименование", Товары.Наименование);
            ЗаписатьXMLЭлемент(ЗаписьXML, "Количество",  Формат(Товары.Количество, "ЧРД=.; ЧГ=0"));
            ЗаписатьXMLЭлемент(ЗаписьXML, "Цена",        Формат(Товары.Цена, "ЧРД=.; ЧГ=0"));
            ЗаписатьXMLЭлемент(ЗаписьXML, "Сумма",       Формат(Товары.Сумма, "ЧРД=.; ЧГ=0"));
            ЗаписьXML.ЗаписатьКонецЭлемента(); // Товар
        КонецЦикла;

        ЗаписьXML.ЗаписатьКонецЭлемента(); // Товары
        ЗаписьXML.ЗаписатьКонецЭлемента(); // Документ

    КонецЦикла;

    ЗаписьXML.ЗаписатьКонецЭлемента(); // КоммерческаяИнформация
    ЗаписьXML.Закрыть();

    Сообщить("Заказы выгружены в: " + ПутьКФайлу);

КонецПроцедуры

// ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================

Процедура ЗаписатьXMLЭлемент(ЗаписьXML, Имя, Значение)
    ЗаписьXML.ЗаписатьНачалоЭлемента(Имя);
    ЗаписьXML.ЗаписатьТекст(Строка(Значение));
    ЗаписьXML.ЗаписатьКонецЭлемента();
КонецПроцедуры

Функция НормализоватьТелефон(Телефон)
    Если НЕ ЗначениеЗаполнено(Телефон) Тогда
        Возврат "";
    КонецЕсли;
    // Оставляем только цифры, добавляем 7 в начало если 10 цифр
    Результат = "";
    Для Индекс = 1 По СтрДлина(Телефон) Цикл
        Символ = Сред(Телефон, Индекс, 1);
        Если Символ >= "0" И Символ <= "9" Тогда
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;
    Если СтрДлина(Результат) = 10 Тогда
        Результат = "7" + Результат;
    КонецЕсли;
    Возврат Результат;
КонецФункции

