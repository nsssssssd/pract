// ============================================================================
// КОД ДЛЯ ОБРАБОТКИ С УЖЕ СОЗДАННОЙ ФОРМОЙ
// Используй, если форма нарисована в конфигураторе вручную.
// Процедура ПриСозданииНаСервере НЕ НУЖНА.
// ============================================================================
// В форме должны быть созданы:
//   Реквизиты: ПутьКФайлу, ДатаНачала, ДатаОкончания, СтатусЗаказа
//   Команда: ВыгрузитьЗаказы (действие → клиентская процедура ВыгрузитьЗаказы)
//   Элементы: поля ввода для реквизитов и кнопка с командой ВыгрузитьЗаказы
// ============================================================================

&НаКлиенте
Процедура ВыгрузитьЗаказы(Команда)
    ВыгрузитьЗаказыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьЗаказыНаСервере()
    
    // ---------- НАСТРОЙКИ ПОД ВАШУ БАЗУ ----------
    ИмяДокументаЗаказ = "ЗаказПокупателя";  // замените на имя вашего документа
    ИмяРеквизитаКонтрагент = "Контрагент";    // контрагент в шапке заказа
    ИмяРеквизитаАдрес = "АдресДоставки";      // адрес доставки (строка или не заполнен)
    ИмяТабЧастиТовары = "Товары";             // табличная часть с товарами
    ИмяРеквизитаСтатус = "Статус";            // статус заказа (строка/перечисление)
    ИмяРеквизитаТелефон = "Телефон";          // телефон контрагента
    
    // Если в вашей базе телефон хранится в контакте/табличной части — подстройте запрос
    // ---------------------------------------------
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Заказ.Ссылка КАК Ссылка,
        |   Заказ.Номер КАК Номер,
        |   Заказ.Дата КАК Дата,
        |   Заказ." + ИмяРеквизитаСтатус + " КАК Статус,
        |   Заказ." + ИмяРеквизитаКонтрагент + ".Представление КАК Клиент,
        |   ЕСТЬNULL(Заказ." + ИмяРеквизитаКонтрагент + "." + ИмяРеквизитаТелефон + ", """") КАК Телефон,
        |   Заказ." + ИмяРеквизитаАдрес + " КАК Адрес
        |ИЗ
        |   Документ." + ИмяДокументаЗаказ + " КАК Заказ
        |ГДЕ
        |   Заказ.Проведен
        |   И Заказ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
    
    // Если фильтр по статусу задан
    Если ЗначениеЗаполнено(СтатусЗаказа) Тогда
        Запрос.Текст = Запрос.Текст + "
        |   И Заказ." + ИмяРеквизитаСтатус + " = &СтатусЗаказа";
        Запрос.УстановитьПараметр("СтатусЗаказа", СтатусЗаказа);
    КонецЕсли;
    
    Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
    Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
    
    Результат = Запрос.Выполнить().Выбрать();
    
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписьJSON.ЗаписатьНачалоОбъекта();
    ЗаписьJSON.ЗаписатьИмяСвойства("orders");
    ЗаписьJSON.ЗаписатьНачалоМассива();
    
    Пока Результат.Следующий() Цикл
        
        ЗаказОбъект = Результат.Ссылка.ПолучитьОбъект();
        
        // Считаем сумму заказа по табличной части
        СуммаДокумента = 0;
        Для Каждого СтрокаТовары Из ЗаказОбъект[ИмяТабЧастиТовары] Цикл
            СуммаДокумента = СуммаДокумента + СтрокаТовары.Сумма;
        КонецЦикла;
        
        ЗаписьJSON.ЗаписатьНачалоОбъекта();
        
        ЗаписьJSON.ЗаписатьИмяСвойства("number");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Результат.Номер));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("date");
        ЗаписьJSON.ЗаписатьЗначение(Формат(Результат.Дата, "ДФ=yyyy-MM-dd"));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("status");
        ЗаписьJSON.ЗаписатьЗначение(Строка(Результат.Статус));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("total");
        ЗаписьJSON.ЗаписатьЗначение(Число(СуммаДокумента));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("clientName");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(Результат.Клиент));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("clientPhone");
        ЗаписьJSON.ЗаписатьЗначение(НормализоватьТелефон(Результат.Телефон));
        
        ЗаписьJSON.ЗаписатьИмяСвойства("address");
        ЗаписьJSON.ЗаписатьЗначение(СокрЛП(?(ЗначениеЗаполнено(Результат.Адрес), Результат.Адрес, "—")));
        
        // --- Товары ---
        ЗаписьJSON.ЗаписатьИмяСвойства("items");
        ЗаписьJSON.ЗаписатьНачалоМассива();
        
        Для Каждого СтрокаТовары Из ЗаказОбъект[ИмяТабЧастиТовары] Цикл
            
            ЗаписьJSON.ЗаписатьНачалоОбъекта();
            
            ЗаписьJSON.ЗаписатьИмяСвойства("name");
            ЗаписьJSON.ЗаписатьЗначение(СокрЛП(СтрокаТовары.Номенклатура));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("quantity");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Количество));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("price");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Цена));
            
            ЗаписьJSON.ЗаписатьИмяСвойства("sum");
            ЗаписьJSON.ЗаписатьЗначение(Число(СтрокаТовары.Сумма));
            
            ЗаписьJSON.ЗаписатьКонецОбъекта();
            
        КонецЦикла;
        
        ЗаписьJSON.ЗаписатьКонецМассива();
        
        ЗаписьJSON.ЗаписатьКонецОбъекта();
        
    КонецЦикла;
    
    ЗаписьJSON.ЗаписатьКонецМассива();
    ЗаписьJSON.ЗаписатьКонецОбъекта();
    
    JSONТекст = ЗаписьJSON.Закрыть();
    
    // Записываем файл
    ТекстовыйДокумент = Новый ТекстовыйДокумент;
    ТекстовыйДокумент.УстановитьТекст(JSONТекст);
    ТекстовыйДокумент.Записать(ПутьКФайлу, КодировкаТекста.UTF8);
    
    Сообщить("Выгружено заказов: " + Результат.Количество());
    Сообщить("Файл сохранён: " + ПутьКФайлу);
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция НормализоватьТелефон(Телефон)
    
    Результат = "";
    Для Индекс = 1 По СтрДлина(Телефон) Цикл
        Символ = Сред(Телефон, Индекс, 1);
        Если Найти("0123456789", Символ) > 0 Тогда
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;
    
    // Приводим к формату 7XXXXXXXXXX
    Если СтрДлина(Результат) = 11 И Лев(Результат, 1) = "8" Тогда
        Результат = "7" + Сред(Результат, 2);
    ИначеЕсли СтрДлина(Результат) = 10 Тогда
        Результат = "7" + Результат;
    КонецЕсли;
    
    Возврат Результат;
    
КонецФункции
